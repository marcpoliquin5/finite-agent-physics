# IBM watsonx integration (not used by the deterministic simulator)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# FINITE durable control plane (use a random 32+ character value)
FINITE_STATE_DIR=.finite
FINITE_CONTROL_BEARER_TOKEN=
FINITE_ALLOW_ANONYMOUS_STATUS_STREAM=false
# Exact comma-separated browser origins permitted to call the REST/SSE API.
FINITE_CONTROL_ALLOWED_ORIGINS=http://localhost:3001
